  "authors": [
    "itz0cat"
  ],
  "contact": {
    "homepage": "https://github.com/itz0cat/CatPay",
    "sources": "https://github.com/itz0cat/CatPay"
  },
  "license": "MIT",
  "icon": "assets/catpay/icon.png",
